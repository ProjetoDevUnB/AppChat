EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Chave do Maps SDK for Android, restrita ao pacote Android e ao SHA-1 de assinatura.
# Apesar de não usar EXPO_PUBLIC_, ela será incorporada ao APK pelo app.config.js.
GOOGLE_MAPS_API_KEY=your_android_maps_api_key

# No EAS: variável File com o google-services.json (não é o JSON da conta de serviço).
# Localmente, o app usa ./google-services.json quando esta variável não está definida.
# GOOGLE_SERVICES_JSON=./google-services.json
